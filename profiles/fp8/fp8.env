# ============================================================================
# Qwen3.8-27B-FP8 + DSpark + XPU graphs -- the profile that holds the recorded
# best result. Every value below was the value on the live endpoint when the
# numbers in the README were measured.
#
# Consumed by profiles/fp8/docker-compose.yml (compose `env_file`). Values here
# are read by scripts/serve.sh, which assembles the final `vllm serve` line.
#
# Items marked [HW] are the ones a different box plausibly has to change.
# ============================================================================

# --- paths -------------------------------------------------------------------
# [HW] All three must exist on a pool with room: 33 GB of models, and the
# vllm/triton/inductor caches fill a boot drive during autotune. setup.sh creates
# the cache dirs and regenerates the runstate dir. These are here rather than only
# in setup.sh so `docker compose` works standalone.
# RUNSTATE_DIR is relative to THIS directory (compose resolves relative bind
# sources against the compose file dir), so both setup.sh and a manual
# `docker compose up -d` generate and mount the same place.
MODELS_DIR=/mnt/cache/models
CACHE_DIR=/mnt/cache/.cache
# Must keep the leading ./ : compose reads a relative bind source that lacks it as a
# NAMED VOLUME, and fails with "service fp8 refers to undefined volume
# runstate/dri-by-path: invalid compose project".
RUNSTATE_DIR=./runstate
# HF repo ids are Qwen/Qwen3.8-27B-FP8 and rwmacy/qwen3.8-27b-dflash-drafter-fp8-b70
# (pinned commits in scripts/download-models.sh); these are the local directory names.
TARGET_DIR=Qwen3.8-27B-FP8
DRAFTER_DIR=qwen3.8-27b-dflash-drafter-fp8-b70

# --- image -------------------------------------------------------------------
# Built locally by setup.sh from image/Dockerfile. Never pulled.
IMAGE=vllm-llmscaler:icr26.35

# --- container placement -----------------------------------------------------
# [HW] The two Arc Pro B70 PCI BDFs. This is normally the only device setting to
# change: setup.sh resolves the card/render node names from these.
B70_BDFS=0000:03:00.0,0000:83:00.0
# RANK0_CARD / RANK0_RENDER / RANK1_CARD / RANK1_RENDER are deliberately NOT set
# here. Card and render numbers are not stable across boots or across the GPU set, so
# baking them in would eventually mount the wrong devices and oneCCL would abort in
# fill_device_fds -- a confusing failure traceable to a stale comment. setup.sh
# resolves them from B70_BDFS on every run and writes them to ./runstate/devices.env.
# To run compose by hand, pass that file too:
#   docker compose --env-file fp8.env --env-file runstate/devices.env \
#                  -f docker-compose.yml up -d
# [HW] Which of the two B70s is rank 0. vLLM/Level Zero orders devices by PCI
# bus id, so the compose file must hand over exactly the pair, filtered.
CONTAINER_NAME=vllm-arch-fp8

# --- serving surface ---------------------------------------------------------
# The served name is load-bearing if anything upstream routes by model name.
PORT=8103
SERVED_NAME=secondary
TP_SIZE=2

# --- context / batching ------------------------------------------------------
MAX_MODEL_LEN=262144
# [HW] MAX_NUM_SEQS is the single most important number here: the graph ceiling
# is derived from it (see CEILING below). Lower it on a box with less VRAM per
# GPU, and if you change it, recompute CEILING.
MAX_NUM_SEQS=10
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEM_UTIL=0.92
# Off, and it stays off in everything committed to this repository. This is a
# deliberate shipping decision, not an unfixed bug: the tier needs the vllm#52923
# hotfix just to survive a long request (AssertionError in
# offloading/scheduler.py), it has never served a single read on this workload, and
# it consumes host RAM proportional to use. Nobody adopting this recipe should
# inherit it enabled. setup.sh attests the pairing either way and refuses to start
# an unpatched image with the tier on -- if you enable it on an old image, run
# ./setup.sh --rebuild.
#
# 0 omits --kv-offloading-size entirely; a literal 0 is a DIFFERENT config than an
# absent flag, so this is not the same as deleting the line.
#
# To enable it on one machine, create profiles/fp8/host.env (gitignored) with:
#     KV_OFFLOAD_SIZE=50
# It is read after this file by setup.sh, verify.sh, soak.sh, run-all.sh and
# arm.sh, and passed to compose as the final --env-file, so the value attested and
# the value baked into the container cannot disagree. Keep it out of git: the tier
# is a per-box capacity choice, and the same value committed here would be a
# default this repo does not endorse -- plus `git checkout` would silently revert
# it. See docs/kv-offload-defect.md.
KV_OFFLOAD_SIZE=0

# --- speculative decoding ----------------------------------------------------
SPEC=1
# dspark is the V2-runner method and needs no image patch. dflash is a different
# code path and does not boot with this drafter on 0.26 (see docs/dspark-drafter.md).
SPEC_METHOD=dspark
# Static k=7. The one safe value with graphs on. Not a tuning knob -- see
# docs/cudagraph-stride-defect.md before changing it.
NUM_SPEC_TOKENS=7
# Never set this with graphs on. It silently garbles output (6-13/30 correct)
# while acceptance counters stay healthy.
# SPEC_TOKENS_SCHEDULE=[[1,1,7],[2,64,4]]

# --- graphs ------------------------------------------------------------------
XPU_GRAPH=1
COMPILE=1
PREFIX_CACHE=1

# --- KV cache quantization ---------------------------------------------------
KV_CACHE_DTYPE=fp8

# --- model / GDN-state dtype --------------------------------------------------
# The measured-best permutation, not the historical one: this repo's rule is that
# the launcher default and the README numbers are always the most optimized
# settings combination known. W57 measured both pins in paired boots against
# matched controls on this host (full table + falsified-mechanism note in
# scripts/serve.sh):
#   DTYPE=float16                 +6.0% C1 probe, +8.0% conc=10, C1 TTFT -19.6%
#   MAMBA_SSM_CACHE_DTYPE=float16 throughput-neutral alone; +12,660 KV tokens
#                                 alone, +30,073 alongside DTYPE (not additive)
# `auto` is the documented control spelling for A/B work, not a bug: pass
# DTYPE=auto (and MAMBA_SSM_CACHE_DTYPE=auto to omit the flag entirely) to get
# the pre-W57 baseline back. scripts/bench/arm.sh must be told an unpinned arm's
# expectation explicitly -- see DTYPE_AUTO_EXPECT there.
DTYPE=float16
MAMBA_SSM_CACHE_DTYPE=float16

# --- runtime flags -----------------------------------------------------------
# The ceiling rule, not a guess: CEILING = MAX_NUM_SEQS x (1 + NUM_SPEC_TOKENS).
# At 72 the 10-request batch (80 tokens) fell off to eager, which is the only
# state a saturated engine reaches -- worth +37.9% at conc=10.
CEILING=80
EXTRA_VLLM_ARGS=--compilation-config {"mode":"none","cudagraph_mode":"FULL_DECODE_ONLY","max_cudagraph_capture_size":80}

# --- oneCCL / level-zero -----------------------------------------------------
# [HW] P2P. Set CCL_NO_P2P=1 only to reproduce a documented failure; on this
# box it cannot start at all (see scripts/serve.sh).
CCL_NO_P2P=0
# The only mitigation found for the oneCCL IPC-handle wedge. Do not turn off.
CCL_SYCL_ALLREDUCE_TMP_BUF=1

# --- misc --------------------------------------------------------------------
# Warmup burns 64 decode steps through a throwaway completion after /health, so
# the first real requests do not eat Triton JIT. WARMUP=0 disables it.
WARMUP=1
